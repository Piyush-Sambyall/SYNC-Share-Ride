# Copy this file to .env and fill in your own values.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/sync_carpool
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string

# Free test-mode keys from https://dashboard.razorpay.com/signup — no
# business verification needed to test. Leave blank and the app still
# runs fine; online payment just shows a setup message and Cash still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
